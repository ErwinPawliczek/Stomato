# deploy/.env.example — copy to deploy/.env and edit. `docker compose up` reads
# .env from this directory and substitutes the ${VAR:-default} values in
# compose.yaml; with no .env the defaults give an open (token-less) local
# install on http://localhost:8080.

# Bundled Postgres password. Must match the password embedded in
# STOMATO_DATABASE_URL when you override it.
POSTGRES_PASSWORD=stomato

# Full SQLAlchemy database URL. Override only when pointing at an external
# Postgres (compose.yaml's bundled postgres does not follow this host).
# STOMATO_DATABASE_URL=postgresql+psycopg://stomato:stomato@postgres:5432/stomato

# Redis queue URL (solve jobs).
# STOMATO_REDIS_URL=redis://redis:6379/0

# Bearer tokens, comma-separated `token:owner` pairs. Empty = open local mode.
# STOMATO_API_TOKENS=

# Browser origins allowed by CORS. The local stack is served from :8080.
# STOMATO_CORS_ORIGINS=http://localhost:8080
