[importlinter]
root_package = ngdesign

# Dependency direction (Phase 0 ratchet). Lower layers never import higher ones.
# engineering layers (sizing, pid_rules, piping, render, export) must not import the
# simulation engine (thermo, units, solver) — they consume SolvedFlowsheet/PID only.
[importlinter:contract:layers]
name = Layered architecture
type = layers
layers =
    ngdesign.cli
    ngdesign.api
    ngdesign.agent
    ngdesign.export
    ngdesign.pipeline
    ngdesign.flowsheets
    ngdesign.solver
    ngdesign.units
    ngdesign.amine
    ngdesign.thermo
    ngdesign.contracts | ngdesign.registry
    ngdesign.data

[importlinter:contract:engineering-independent]
name = Engineering deliverables never import the simulation engine
type = forbidden
source_modules =
    ngdesign.sizing
    ngdesign.pid_rules
    ngdesign.piping
    ngdesign.render
forbidden_modules =
    ngdesign.thermo
    ngdesign.units
    ngdesign.amine
    ngdesign.solver
    ngdesign.flowsheets
    ngdesign.cli
    ngdesign.api

[importlinter:contract:no-cli-reuse]
name = Nothing imports cli (orchestration belongs in a library module)
type = forbidden
source_modules =
    ngdesign.api
    ngdesign.export
    ngdesign.render
    ngdesign.pid_rules
forbidden_modules =
    ngdesign.cli

